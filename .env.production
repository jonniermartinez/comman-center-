# Variables públicas de producción.
#
# Se versionan a propósito: `NEXT_PUBLIC_*` se incrusta en el bundle del
# navegador, así que no son secretas —la clave publicable está diseñada para
# viajar al cliente y todo lo que alcanza está acotado por RLS—. Tenerlas acá
# hace que la build remota de Cloudflare no dependa de configurar el entorno a
# mano en el panel.
#
# No hay ninguna clave secreta: la aplicación entera funciona con la clave
# publicable y RLS. La administración de cuentas la hacen funciones de
# Postgres guardadas por is_super_admin(), no la Admin API.
NEXT_PUBLIC_SUPABASE_URL=https://yooqgcqdssvtkkschkku.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7OJFZObtvLteH-4-a0hxKg_aMdrDwy3
NEXT_PUBLIC_SITE_URL=https://comman-center.commandcentergenelypse.workers.dev
